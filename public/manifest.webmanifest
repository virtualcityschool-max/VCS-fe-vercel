{
  "id": "/",
  "name": "Virtual City School",
  "short_name": "VCS",
  "description": "Live Cambridge O Level and A Level classes, assignments and timetable.",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#020617",
  "theme_color": "#020617",
  "lang": "en",
  "categories": ["education"],
  "icons": [
    { "src": "/app-icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app-icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app-icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today's classes", "short_name": "Classes", "url": "/student/classes?source=app", "icons": [{ "src": "/app-icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Assignments", "short_name": "Assignments", "url": "/student/assignments?source=app", "icons": [{ "src": "/app-icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
